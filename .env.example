# Opcional: preencha para ativar sincronização em tempo real e listas compartilhadas via Supabase.
# Sem estas variáveis, o PegaLá funciona 100% offline usando IndexedDB.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Variáveis server-only (Vercel Functions /api/prices/*) — NUNCA use prefixo VITE_
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
PRICE_ADAPTERS_ENABLED=all
OSM_CONTACT_EMAIL=contato@pegala.app
PRICE_RATE_LIMIT_SALT=troque-por-um-segredo-aleatorio
